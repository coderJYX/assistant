/* pages/member-add/member-add.wxss */
.page-add {
  min-height: 100vh;
  background: #0d1117;
  padding: 30rpx;
  box-sizing: border-box;
}

/* ===== Top Info ===== */
.top-info {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(240, 136, 62, 0.12) 0%, rgba(219, 109, 40, 0.05) 100%);
  border: 1rpx solid rgba(240, 136, 62, 0.15);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 30rpx;
}

.info-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.info-content {
  flex: 1;
}

.info-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.info-desc {
  font-size: 24rpx;
  color: rgba(230, 237, 243, 0.5);
}

/* ===== Form Card ===== */
.form-card {
  background: linear-gradient(145deg, #161b22 0%, #1c2128 100%);
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.form-group {
  margin-bottom: 32rpx;
}

.label {
  font-size: 26rpx;
  color: rgba(230, 237, 243, 0.55);
  margin-bottom: 14rpx;
  display: block;
  font-weight: 500;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 0 24rpx;
  transition: all 0.2s;
}

.input-wrap:focus-within {
  border-color: #f0883e;
  background: rgba(240, 136, 62, 0.05);
}

.input-icon {
  font-size: 30rpx;
  margin-right: 14rpx;
  opacity: 0.5;
}

.input-field {
  flex: 1;
  height: 96rpx;
  color: #e6edf3;
  font-size: 26rpx;
}

.input-field::placeholder {
  color: rgba(230, 237, 243, 0.25);
}

.clear-btn {
  font-size: 28rpx;
  color: rgba(230, 237, 243, 0.3);
  padding: 10rpx;
}

.input-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.paste-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #f0883e;
  padding: 8rpx 20rpx;
  background: rgba(240, 136, 62, 0.1);
  border-radius: 8rpx;
}

/* ===== Notice ===== */
.notice {
  background: rgba(255, 255, 255, 0.03);
  border-radius: 14rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(230, 237, 243, 0.7);
  margin-bottom: 16rpx;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.notice-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: rgba(240, 136, 62, 0.2);
  color: #f0883e;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-weight: 600;
}

.notice-item text:last-child {
  flex: 1;
  font-size: 24rpx;
  color: rgba(230, 237, 243, 0.45);
  line-height: 1.6;
}

/* ===== Submit ===== */
.submit-btn {
  width: 100%;
}

/* ===== Bottom Tip ===== */
.bottom-tip {
  text-align: center;
  margin-top: 40rpx;
  font-size: 22rpx;
  color: rgba(230, 237, 243, 0.25);
}
