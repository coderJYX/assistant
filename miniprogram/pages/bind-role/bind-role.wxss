/* pages/bind-role/bind-role.wxss */
.page-bind {
  min-height: 100vh;
  background: #0f1923;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: linear-gradient(180deg, rgba(240, 136, 62, 0.12) 0%, rgba(240, 136, 62, 0) 100%);
  pointer-events: none;
}

.content {
  position: relative;
  z-index: 1;
  padding: 100rpx 40rpx 40rpx;
}

/* ===== Hero ===== */
.hero {
  text-align: center;
  margin-bottom: 48rpx;
}

.hero-badge {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  background: linear-gradient(135deg, #f0883e 0%, #d4592a 100%);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(240, 136, 62, 0.3);
}

.hero-icon {
  font-size: 56rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 8rpx;
}

.hero-subtitle {
  font-size: 28rpx;
  color: #f0883e;
  font-weight: 600;
}

/* ===== Info Card ===== */
.info-card {
  display: flex;
  align-items: flex-start;
  background: rgba(63, 185, 80, 0.08);
  border: 1rpx solid rgba(63, 185, 80, 0.15);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.info-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.info-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3fb950;
  margin-bottom: 6rpx;
}

.info-desc {
  font-size: 24rpx;
  color: rgba(230, 237, 243, 0.6);
  line-height: 1.6;
}

/* ===== Form Card ===== */
.form-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 36rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: rgba(230, 237, 243, 0.7);
  margin-bottom: 16rpx;
  font-weight: 600;
}

.required {
  color: #ef4444;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 0 24rpx;
  transition: all 0.2s;
}

.input-wrap:focus-within {
  border-color: #f0883e;
  background: rgba(240, 136, 62, 0.05);
}

.input-wrap.input-error {
  border-color: #ef4444;
  background: rgba(239, 68, 68, 0.06);
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.input-field {
  flex: 1;
  height: 96rpx;
  font-size: 28rpx;
  color: #e6edf3;
}

.clear-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(230, 237, 243, 0.4);
  font-size: 24rpx;
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 12rpx;
  margin-left: 8rpx;
}

.input-actions {
  display: flex;
  margin-top: 16rpx;
}

.paste-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #f0883e;
  padding: 8rpx 0;
}

/* ===== Buttons ===== */
.btn-primary {
  background: linear-gradient(135deg, #f0883e 0%, #d4592a 100%);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  margin-top: 16rpx;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.tip-text {
  text-align: center;
  padding: 20rpx 0 8rpx;
  font-size: 24rpx;
  color: rgba(230, 237, 243, 0.4);
}

/* ===== Bottom ===== */
.bottom-deco {
  position: absolute;
  bottom: 40rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.deco-text {
  font-size: 22rpx;
  color: rgba(230, 237, 243, 0.2);
  letter-spacing: 4rpx;
}
