/* pages/index/index.wxss */
.page-index {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 500rpx;
  background: linear-gradient(180deg, rgba(240, 136, 62, 0.15) 0%, transparent 100%);
  pointer-events: none;
}

.content {
  position: relative;
  z-index: 1;
  padding: 80rpx 40rpx 40rpx;
}

/* ===== Checking Page ===== */
.checking-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.checking-page .hero {
  margin-bottom: 80rpx;
}

.checking-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.checking-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid rgba(240, 136, 62, 0.2);
  border-top-color: #f0883e;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.checking-text {
  font-size: 26rpx;
  color: rgba(230, 237, 243, 0.5);
}

/* ===== Hero ===== */
.hero {
  text-align: center;
  margin-bottom: 60rpx;
}

.hero-badge {
  width: 140rpx;
  height: 140rpx;
  margin: 0 auto 28rpx;
  background: linear-gradient(135deg, #f0883e 0%, #db6d28 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(240, 136, 62, 0.35);
  transform: rotate(-3deg);
}

.hero-icon {
  font-size: 64rpx;
}

.hero-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 8rpx;
  margin-bottom: 12rpx;
}

/* ===== Invite Banner ===== */
.invite-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, rgba(63, 185, 80, 0.15) 0%, rgba(63, 185, 80, 0.05) 100%);
  border: 1rpx solid rgba(63, 185, 80, 0.2);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 28rpx;
}

.invite-icon {
  font-size: 44rpx;
  margin-right: 18rpx;
}

.invite-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #3fb950;
  margin-bottom: 4rpx;
}

.invite-desc {
  font-size: 22rpx;
  color: rgba(230, 237, 243, 0.5);
}

.required {
  color: #f85149;
  margin-left: 4rpx;
}

/* ===== Tab ===== */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 16rpx;
  padding: 10rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: rgba(230, 237, 243, 0.45);
  border-radius: 12rpx;
  transition: all 0.25s ease;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #f0883e 0%, #db6d28 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(240, 136, 62, 0.3);
}

.tab-icon {
  font-size: 32rpx;
}

/* ===== Form Card ===== */
.form-card {
  background: linear-gradient(145deg, #161b22 0%, #1c2128 100%);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.3);
}

.form-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.form-desc {
  font-size: 24rpx;
  color: rgba(230, 237, 243, 0.4);
  margin-bottom: 36rpx;
}

.form-group {
  margin-bottom: 32rpx;
}

.label {
  font-size: 26rpx;
  color: rgba(230, 237, 243, 0.55);
  margin-bottom: 14rpx;
  display: block;
  font-weight: 500;
}

.input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 14rpx;
  padding: 0 24rpx;
  transition: all 0.2s;
}

.input-wrap:focus-within {
  border-color: #f0883e;
  background: rgba(240, 136, 62, 0.05);
}

.input-wrap.input-error {
  border-color: #ef4444;
  background: rgba(239, 68, 68, 0.06);
}

.error-text {
  display: block;
  font-size: 24rpx;
  color: #ef4444;
  margin-top: 12rpx;
  margin-left: 8rpx;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.input-field {
  flex: 1;
  height: 96rpx;
  color: #e6edf3;
  font-size: 28rpx;
}

.input-field::placeholder {
  color: rgba(230, 237, 243, 0.25);
}

.submit-btn {
  margin-top: 12rpx;
  width: 100%;
}

.input-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 14rpx;
}

.paste-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #f0883e;
  padding: 8rpx 20rpx;
  background: rgba(240, 136, 62, 0.1);
  border-radius: 8rpx;
}

/* ===== Tip ===== */
.tip-box {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  gap: 8rpx;
}

.tip-icon {
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: rgba(230, 237, 243, 0.35);
}

/* ===== Bottom ===== */
.bottom-deco {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.deco-text {
  font-size: 22rpx;
  color: rgba(230, 237, 243, 0.2);
  letter-spacing: 4rpx;
}
