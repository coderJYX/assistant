/* app.wxss 全局样式 — 攻城助手 */
page {
  background: #0d1117;
  color: #e6edf3;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  min-height: 100vh;
}

.container {
  padding: 30rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

/* ===== 卡片 ===== */
.card {
  background: linear-gradient(145deg, #161b22 0%, #1c2128 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);
}

/* ===== 按钮 ===== */
.btn-primary {
  background: linear-gradient(135deg, #f0883e 0%, #db6d28 100%);
  color: #fff;
  border: none;
  border-radius: 14rpx;
  font-size: 32rpx;
  font-weight: 700;
  padding: 26rpx 0;
  text-align: center;
  letter-spacing: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(240, 136, 62, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.06);
  color: #e6edf3;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 14rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 500;
}

.btn-secondary::after {
  border: none;
}

.btn-danger {
  background: rgba(248, 81, 73, 0.12);
  color: #f85149;
  border: 1rpx solid rgba(248, 81, 73, 0.3);
  border-radius: 14rpx;
  font-size: 30rpx;
  padding: 24rpx 0;
  text-align: center;
  font-weight: 600;
}

.btn-danger::after {
  border: none;
}

/* ===== 输入框 ===== */
.input-field {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  padding: 26rpx 28rpx;
  color: #e6edf3;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #f0883e;
  background: rgba(240, 136, 62, 0.05);
}

.input-field::placeholder {
  color: rgba(230, 237, 243, 0.3);
}

/* ===== 标签 ===== */
.label {
  font-size: 26rpx;
  color: rgba(230, 237, 243, 0.5);
  margin-bottom: 14rpx;
  display: block;
  font-weight: 500;
}

/* ===== 标题 ===== */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #f0883e, #db6d28);
  border-radius: 3rpx;
  margin-right: 14rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  text-align: center;
  padding: 140rpx 0;
  color: rgba(230, 237, 243, 0.35);
}

.empty-state .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-state .empty-text {
  font-size: 28rpx;
}

/* ===== 数据行 ===== */
.data-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.data-row:last-child {
  border-bottom: none;
}

.data-label {
  color: rgba(230, 237, 243, 0.5);
  font-size: 26rpx;
}

.data-value {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.data-value.highlight {
  color: #f0883e;
}

.data-value.small {
  font-size: 24rpx;
  font-weight: 400;
  color: rgba(230, 237, 243, 0.5);
}

/* ===== Tab 切换 ===== */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 14rpx;
  padding: 8rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: rgba(230, 237, 243, 0.45);
  border-radius: 10rpx;
  transition: all 0.25s ease;
  font-weight: 500;
}

.tab-item.active {
  background: linear-gradient(135deg, #f0883e 0%, #db6d28 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(240, 136, 62, 0.25);
}

/* ===== 加载中 ===== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-box {
  background: #161b22;
  border-radius: 16rpx;
  padding: 40rpx 60rpx;
  text-align: center;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

.loading-text {
  color: rgba(230, 237, 243, 0.7);
  font-size: 26rpx;
  margin-top: 16rpx;
}
